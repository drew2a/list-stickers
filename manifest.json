{
  "manifest_version": 3,
  "name": "List Stickers: Sticky Notes for Any Website",
  "short_name": "List Stickers",
  "version": "1.0.1",
  "description": "Put sticky notes on any web page or list item. Mark products, lessons and articles as done, liked or for later. Private, no account.",
  "homepage_url": "https://github.com/drew2a/list-stickers",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "List Stickers",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
